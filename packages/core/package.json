{
  "name": "@uglifruits/ui",
  "version": "0.8.0",
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/types/core/index.d.ts",
  "unpkg": "./dist/umd/index.umd.js",
  "jsdelivr": "./dist/umd/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./style.css": "./dist/es/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xylanny/uglifruit-ui"
  },
  "description": "Uglifruits UI, a component lib!",
  "keywords": [
    "clear"
  ],
  "author": "xylanny",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build:es": "vite build --config vite.es.config.ts",
    "build:umd": "vite build --config vite.umd.config.ts",
    "build": "pnpm run clean && pnpm run build:es && pnpm run build:umd"
  },
  "devDependencies": {
    "@uglifruits/components": "workspace:*",
    "@uglifruits/theme": "workspace:*",
    "@uglifruits/utils": "workspace:*"
  }
}
